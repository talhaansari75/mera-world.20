# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mera_world"

# Auth (Better Auth)
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:8080"

# Optional
VITE_API_URL=""

# Blockchain / Base USDC payments
# Start with Base Sepolia for testing.
BASE_CHAIN_ID=84532
BASE_USDC_ADDRESS=0x036CbD53842c5426634aDC6F8B1F4F4Ff6C8B0b
BASE_PAYMENT_RECIPIENT=0xYOUR_WALLET_ADDRESS
BASE_RPC_URL=https://sepolia.base.org

# Minimum mined confirmations before a blockchain payment can credit the account
BASE_REQUIRED_CONFIRMATIONS=12

# Advanced blockchain payments
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_USDC_ADDRESS=
ETHEREUM_RPC_URL=
ETHEREUM_USDC_ADDRESS=
BLOCKCHAIN_LISTENER_REORG_WINDOW=12
AA_ENABLED=false
